generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  whatsappPhoneId  String?  @unique
  whatsappToken    String?
  notificationWhatsappNumber String?
  bookingAlertsEnabled Boolean @default(true)
  city             String   @default("Hyderabad")
  isActive         Boolean  @default(true)
  plan             Plan     @default(STARTER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users         User[]
  
  bookings      Booking[]
  customers     Customer[]
  conversations Conversation[]
  services      Service[]
  tenantContext TenantContext?

  @@map("tenants")
}

enum Plan {
  STARTER
  GROWTH
  ENTERPRISE
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappPhone String
  name          String?
  locality      String?
  address       String?
  latitude      Float?
  longitude     Float?
  isBlocked     Boolean  @default(false)
  totalBookings Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  conversations Conversation[]

  @@unique([tenantId, whatsappPhone])
  @@index([tenantId])
  @@index([whatsappPhone])
  @@map("customers")
}


model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  bookingRef      String        @unique
  serviceName     String                        // "AC Cleaning", "10KL Sweet Water", "Teeth Cleaning"
  quantity        Float?                        // 10 (KL), 1 (unit), 2 (rooms) — generic
  unit            String?                       // "KL", "unit", "rooms", "hours"
  scheduledDate   DateTime
  scheduledSlot   String?
  deliveryAddress String
  locality        String?
  notes           String?

  status          BookingStatus @default(PENDING)
  totalAmount     Float?
  paidAmount      Float?
  paymentStatus   PaymentStatus @default(UNPAID)

  confirmedAt     DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  source          BookingSource @default(WHATSAPP)
  aiParsed        Boolean       @default(false)
  assignedTo      String?       // staff name or ID — optional

  @@index([tenantId])
  @@index([customerId])
  @@index([scheduledDate])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BookingSource {
  WHATSAPP
  DASHBOARD
  API
}

model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  state         String   @default("IDLE")
  context       Json     @default("{}")
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?      @unique
  direction      Direction
  content        String
  messageType    String       @default("text")
  isAiGenerated  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

enum Direction {
  INBOUND
  OUTBOUND
}

model Service {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceName String
  serviceCode String
  basePrice   Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, serviceCode])
  @@index([tenantId])
  @@map("services")
}

model TenantContext {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  context   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_contexts")
}
